{
  "name": "riftcards",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "sh scripts/with-card-images.sh expo start",
    "start:clear": "sh scripts/with-card-images.sh expo start --clear",
    "build:ios": "sh scripts/with-card-images.sh expo run:ios",
    "build:ios:device": "sh scripts/with-card-images.sh expo run:ios --device",
    "build:android": "sh scripts/with-card-images.sh expo run:android",
    "build:android:device": "sh scripts/with-card-images.sh expo run:android --device",
    "convert:card-images": "find data/images -type f ! -name '*.webp' ! -name '*.json' -exec sh -c 'for f; do cwebp -quiet -q 82 \"$f\" -o \"${f%.*}.webp\" && rm \"$f\"; done' _ {} +",
    "serve:images": "python3 -m http.server 8787 --directory data/images",
    "reset-project": "node ./scripts/reset-project.js",
    "web": "expo start --web",
    "check:lint": "oxlint",
    "format": "oxfmt",
    "check:types": "tsc --noEmit",
    "test": "jest --runInBand",
    "check:db": "drizzle-kit check",
    "check:deps": "deno run --allow-read ./scripts/dependency-graph.ts",
    "db:pull": "sh scripts/pull-device-db.sh",
    "fetch:cards": "deno run --sloppy-imports --allow-read --allow-write --allow-env --allow-net ./scripts/fetch-cards.ts",
    "fetch:card-images": "deno run --sloppy-imports --allow-read --allow-write --allow-env --allow-net ./scripts/fetch-card-images.ts",
    "generate:core-rules-seed": "deno run --sloppy-imports --allow-read --allow-write --allow-env ./scripts/generate-core-rules-seed.ts",
    "generate:catalog-seed": "deno run --sloppy-imports --allow-read --allow-write --allow-env ./scripts/generate-catalog-seed.ts"
  },
  "dependencies": {
    "@expo/ui": "~57.0.16",
    "@shopify/flash-list": "^2.3.2",
    "@tanstack/react-query": "^5.102.8",
    "drizzle-orm": "^1.0.0-rc.4",
    "expo": "~57.0.20",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.3",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.4",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.19",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "ts-pattern": "^5.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^26.4.1",
    "@types/react": "~19.2.2",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/tests/style-stub.js",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "preset": "jest-expo",
    "watchman": false,
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@shopify/flash-list))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  }
}
